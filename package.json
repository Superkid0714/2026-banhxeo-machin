{
  "name": "festival-customer-order",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/recovery.test.ts",
    "test:api": "node --test tests/api.test.mjs",
    "test:deploy": "node --test tests/deployment.test.mjs",
    "test:admin": "node --test tests/admin.test.mjs",
    "test:operations": "node --experimental-transform-types --test tests/operations.test.ts",
    "test:reservation": "node --experimental-transform-types --test tests/reservationLookup.test.ts tests/reservationCheckIn.test.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/start.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/start.mjs",
    "start": "node dist-server/start.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "engines": { "node": "22.x" },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "esbuild": "^0.25.12",
    "vite": "^6.4.0"
  }
}
