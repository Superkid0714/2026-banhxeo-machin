# Customer-visible payment instructions embedded at build time.
# Never use VITE_* for API secrets or credentials.
VITE_PAYMENT_BANK=
VITE_PAYMENT_HOLDER=
VITE_PAYMENT_ACCOUNT=

# Server-only reservation endpoint. Leave empty to use the production reservation service.
# HTTPS only. Never expose ORDER_API_KEY via VITE_* variables.
RESERVATION_LOOKUP_URL=
